                    "sprites": {
                        "default": {
                            "imageUrl": ""
                        }
                    }
                },
                {
                    "uuid": "pl-xiulm6e76sxb2dlv",
                    "name": "산장 응접실",
                    "description": "용의자들이 모여 있는 공간. 서로를 의심하며 날 선 대화가 오간다.",
                    "sprites": {
                        "default": {
                            "imageUrl": ""
                        }
                    }
                }
            ],
            "style": {
                "prompt": "폭설로 고립된 현대의 외딴 산장을 배경으로 한 정통 미스터리 추리물이다. 용의자들의 진술 속 모순과 현장의 물증을 논리적으로 연결하여 서술한다.",
